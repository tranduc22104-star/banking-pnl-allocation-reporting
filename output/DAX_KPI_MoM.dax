-- DAX 01. Khoi KPI Cards (xuat y xi tu model PBI Desktop "123", 2026-10-16)
-- Table: 'LAI LO (Visuals & DAX)' | Nguon so: 'banking_project v_baocao_tonghop' | Slicer: 'banking_project dim_month'[month_key] (don chon)
-- Fact YTD nen thang M = YTD(M) - YTD(M-1). MoM ty le = (M - M_truoc) / ABS(M_truoc).
-- Mau: xanh #16A34A (tot), do #DC2626 (xau/lo), xam #6B7280 (ky dau nam). ChiPhi nguoc (tang do), CIR nguoc (tang do).
-- Gan card: Detail = [* MoM Text], Mau chu/nen = [* Color] (Format -> fx Field value).

-- 1. Loi nhuan truoc thue (thang lo -> do ep) --
KPI LNTT MoM Text = VAR _cur = SELECTEDVALUE ( 'banking_project dim_month'[month_key], MAX ( 'banking_project dim_month'[month_key] ) ) VAR _prev = IF ( MOD ( _cur, 100 ) = 1, _cur - 100 + 11, _cur - 1 ) VAR _prev2 = IF ( MOD ( _prev, 100 ) = 1, _prev - 100 + 11, _prev - 1 ) VAR _thangTruoc = MOD ( _prev, 100 ) VAR _ytdCur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _ytdPrev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _ytdPrev2 = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _mCur = IF ( ISBLANK ( _ytdPrev ), _ytdCur, _ytdCur - _ytdPrev ) VAR _mPrev = IF ( ISBLANK ( _ytdPrev2 ), _ytdPrev, _ytdPrev - _ytdPrev2 ) VAR _m = DIVIDE ( _mCur - _mPrev, ABS ( _mPrev ) ) RETURN IF ( _mCur < 0, "Gây lỗ vốn ngân hàng", IF ( ISBLANK ( _ytdPrev ), "Kỳ đầu năm (Chưa có so sánh)", IF ( _m >= 0, UNICHAR ( 9650 ) & " Tăng +" & FORMAT ( _m, "0.0%" ) & " so với Tháng " & _thangTruoc, UNICHAR ( 9660 ) & " Giảm " & FORMAT ( ABS ( _m ), "0.0%" ) & " so với Tháng " & _thangTruoc ) ) )
KPI LNTT Color = VAR _cur = SELECTEDVALUE ( 'banking_project dim_month'[month_key], MAX ( 'banking_project dim_month'[month_key] ) ) VAR _prev = IF ( MOD ( _cur, 100 ) = 1, _cur - 100 + 11, _cur - 1 ) VAR _prev2 = IF ( MOD ( _prev, 100 ) = 1, _prev - 100 + 11, _prev - 1 ) VAR _ytdCur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _ytdPrev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _ytdPrev2 = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _mCur = IF ( ISBLANK ( _ytdPrev ), _ytdCur, _ytdCur - _ytdPrev ) VAR _mPrev = IF ( ISBLANK ( _ytdPrev2 ), _ytdPrev, _ytdPrev - _ytdPrev2 ) VAR _m = DIVIDE ( _mCur - _mPrev, ABS ( _mPrev ) ) RETURN SWITCH ( TRUE (), _mCur < 0, "#DC2626", ISBLANK ( _m ) || ISBLANK ( _ytdPrev ), "#6B7280", _m >= 0, "#16A34A", "#DC2626" )

-- 2. Tong thu nhap HD = E (tang tot) --
KPI ThuNhap MoM Text = VAR _cur = SELECTEDVALUE ( 'banking_project dim_month'[month_key], MAX ( 'banking_project dim_month'[month_key] ) ) VAR _prev = IF ( MOD ( _cur, 100 ) = 1, _cur - 100 + 11, _cur - 1 ) VAR _prev2 = IF ( MOD ( _prev, 100 ) = 1, _prev - 100 + 11, _prev - 1 ) VAR _thangTruoc = MOD ( _prev, 100 ) VAR _ytdCur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_thunhap_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _ytdPrev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_thunhap_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _mCur = IF ( ISBLANK ( _ytdPrev ), _ytdCur, _ytdCur - _ytdPrev ) VAR _ytdPrev2 = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_thunhap_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _mPrev = IF ( ISBLANK ( _ytdPrev2 ), _ytdPrev, _ytdPrev - _ytdPrev2 ) VAR _m = DIVIDE ( _mCur - _mPrev, ABS ( _mPrev ) ) RETURN IF ( ISBLANK ( _m ) || ISBLANK ( _ytdPrev ), "Kỳ đầu năm (Chưa có so sánh)", IF ( _m >= 0, UNICHAR ( 9650 ) & " Tăng +" & FORMAT ( _m, "0.0%" ) & " so với Tháng " & _thangTruoc, UNICHAR ( 9660 ) & " Giảm " & FORMAT ( ABS ( _m ), "0.0%" ) & " so với Tháng " & _thangTruoc ) )
KPI ThuNhap Color = VAR _cur = SELECTEDVALUE ( 'banking_project dim_month'[month_key], MAX ( 'banking_project dim_month'[month_key] ) ) VAR _prev = IF ( MOD ( _cur, 100 ) = 1, _cur - 100 + 11, _cur - 1 ) VAR _prev2 = IF ( MOD ( _prev, 100 ) = 1, _prev - 100 + 11, _prev - 1 ) VAR _ytdCur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_thunhap_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _ytdPrev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_thunhap_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _mCur = IF ( ISBLANK ( _ytdPrev ), _ytdCur, _ytdCur - _ytdPrev ) VAR _ytdPrev2 = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_thunhap_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _mPrev = IF ( ISBLANK ( _ytdPrev2 ), _ytdPrev, _ytdPrev - _ytdPrev2 ) VAR _m = DIVIDE ( _mCur - _mPrev, ABS ( _mPrev ) ) RETURN SWITCH ( TRUE (), ISBLANK ( _m ) || ISBLANK ( _ytdPrev ), "#6B7280", _m >= 0, "#16A34A", "#DC2626" )

-- 3. Tong chi phi = F (tri tuyet doi, tang xau -> do) --
KPI ChiPhi MoM Text = VAR _cur = SELECTEDVALUE ( 'banking_project dim_month'[month_key], MAX ( 'banking_project dim_month'[month_key] ) ) VAR _prev = IF ( MOD ( _cur, 100 ) = 1, _cur - 100 + 11, _cur - 1 ) VAR _prev2 = IF ( MOD ( _prev, 100 ) = 1, _prev - 100 + 11, _prev - 1 ) VAR _thangTruoc = MOD ( _prev, 100 ) VAR _ytdCur = - CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_chiphi_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _ytdPrev = - CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_chiphi_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _mCur = IF ( ISBLANK ( _ytdPrev ), _ytdCur, _ytdCur - _ytdPrev ) VAR _ytdPrev2 = - CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_chiphi_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _mPrev = IF ( ISBLANK ( _ytdPrev2 ), _ytdPrev, _ytdPrev - _ytdPrev2 ) VAR _m = DIVIDE ( _mCur - _mPrev, ABS ( _mPrev ) ) RETURN IF ( ISBLANK ( _m ) || ISBLANK ( _ytdPrev ), "Kỳ đầu năm (Chưa có so sánh)", IF ( _m >= 0, UNICHAR ( 9650 ) & " Tăng +" & FORMAT ( _m, "0.0%" ) & " so với Tháng " & _thangTruoc, UNICHAR ( 9660 ) & " Giảm " & FORMAT ( ABS ( _m ), "0.0%" ) & " so với Tháng " & _thangTruoc ) )
KPI ChiPhi Color = VAR _cur = SELECTEDVALUE ( 'banking_project dim_month'[month_key], MAX ( 'banking_project dim_month'[month_key] ) ) VAR _prev = IF ( MOD ( _cur, 100 ) = 1, _cur - 100 + 11, _cur - 1 ) VAR _prev2 = IF ( MOD ( _prev, 100 ) = 1, _prev - 100 + 11, _prev - 1 ) VAR _ytdCur = - CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_chiphi_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _ytdPrev = - CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_chiphi_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _mCur = IF ( ISBLANK ( _ytdPrev ), _ytdCur, _ytdCur - _ytdPrev ) VAR _ytdPrev2 = - CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_chiphi_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _mPrev = IF ( ISBLANK ( _ytdPrev2 ), _ytdPrev, _ytdPrev - _ytdPrev2 ) VAR _m = DIVIDE ( _mCur - _mPrev, ABS ( _mPrev ) ) RETURN SWITCH ( TRUE (), ISBLANK ( _m ) || ISBLANK ( _ytdPrev ), "#6B7280", _m > 0, "#DC2626", _m < 0, "#16A34A", "#6B7280" )

-- 4. CIR (ty so thang, MoM %, tang xau -> do) --
KPI CIR MoM Text = VAR _cur = SELECTEDVALUE ( 'banking_project dim_month'[month_key], MAX ( 'banking_project dim_month'[month_key] ) ) VAR _prev = IF ( MOD ( _cur, 100 ) = 1, _cur - 100 + 11, _cur - 1 ) VAR _prev2 = IF ( MOD ( _prev, 100 ) = 1, _prev - 100 + 11, _prev - 1 ) VAR _thangTruoc = MOD ( _prev, 100 ) VAR _eCur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_thunhap_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _fCur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_chiphi_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _ePrev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_thunhap_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _fPrev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_chiphi_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _cirCur = DIVIDE ( - IF ( ISBLANK ( _fPrev ), _fCur, _fCur - _fPrev ), IF ( ISBLANK ( _ePrev ), _eCur, _eCur - _ePrev ) ) VAR _ePrev2 = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_thunhap_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _fPrev2 = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_chiphi_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _cirPrev = DIVIDE ( - IF ( ISBLANK ( _fPrev2 ), _fPrev, _fPrev - _fPrev2 ), IF ( ISBLANK ( _ePrev2 ), _ePrev, _ePrev - _ePrev2 ) ) VAR _diff = _cirCur - _cirPrev VAR _pct = DIVIDE ( _diff, ABS ( _cirPrev ) ) RETURN IF ( ISBLANK ( _diff ) || ISBLANK ( _ePrev ), "Kỳ đầu năm (Chưa có so sánh)", IF ( _diff > 0, UNICHAR ( 9650 ) & " Tăng +" & FORMAT ( _pct, "0.0%" ) & " so với Tháng " & _thangTruoc, UNICHAR ( 9660 ) & " Giảm " & FORMAT ( ABS ( _pct ), "0.0%" ) & " so với Tháng " & _thangTruoc ) )
KPI CIR Color = VAR _cur = SELECTEDVALUE ( 'banking_project dim_month'[month_key], MAX ( 'banking_project dim_month'[month_key] ) ) VAR _prev = IF ( MOD ( _cur, 100 ) = 1, _cur - 100 + 11, _cur - 1 ) VAR _prev2 = IF ( MOD ( _prev, 100 ) = 1, _prev - 100 + 11, _prev - 1 ) VAR _eCur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_thunhap_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _fCur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_chiphi_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _ePrev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_thunhap_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _fPrev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_chiphi_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _cirCur = DIVIDE ( - IF ( ISBLANK ( _fPrev ), _fCur, _fCur - _fPrev ), IF ( ISBLANK ( _ePrev ), _eCur, _eCur - _ePrev ) ) VAR _ePrev2 = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_thunhap_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _fPrev2 = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[tong_chiphi_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _cirPrev = DIVIDE ( - IF ( ISBLANK ( _fPrev2 ), _fPrev, _fPrev - _fPrev2 ), IF ( ISBLANK ( _ePrev2 ), _ePrev, _ePrev - _ePrev2 ) ) VAR _diff = _cirCur - _cirPrev RETURN SWITCH ( TRUE (), ISBLANK ( _diff ) || ISBLANK ( _ePrev ), "#6B7280", _diff <= 0, "#16A34A", "#DC2626" )

-- 5. Margin = LNTT/H thang (H = B + D3, MoM % nhu CIR) --
KPI Margin MoM Text = VAR _cur = SELECTEDVALUE ( 'banking_project dim_month'[month_key], MAX ( 'banking_project dim_month'[month_key] ) ) VAR _prev = IF ( MOD ( _cur, 100 ) = 1, _cur - 100 + 11, _cur - 1 ) VAR _prev2 = IF ( MOD ( _prev, 100 ) = 1, _prev - 100 + 11, _prev - 1 ) VAR _thangTruoc = MOD ( _prev, 100 ) VAR _lnttCur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _lnttPrev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _lnttM = IF ( ISBLANK ( _lnttPrev ), _lnttCur, _lnttCur - _lnttPrev ) VAR _bCur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[thu_nhap_the_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _bPrev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[thu_nhap_the_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _bM = IF ( ISBLANK ( _bPrev ), _bCur, _bCur - _bPrev ) VAR _d3Cur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[dt_kd_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _d3Prev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[dt_kd_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _d3M = IF ( ISBLANK ( _d3Prev ), _d3Cur, _d3Cur - _d3Prev ) VAR _mgCur = DIVIDE ( _lnttM, _bM + _d3M ) VAR _lnttPrev2 = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _lnttMPrev = IF ( ISBLANK ( _lnttPrev2 ), _lnttPrev, _lnttPrev - _lnttPrev2 ) VAR _bPrev2 = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[thu_nhap_the_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _bMPrev = IF ( ISBLANK ( _bPrev2 ), _bPrev, _bPrev - _bPrev2 ) VAR _d3Prev2 = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[dt_kd_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _d3MPrev = IF ( ISBLANK ( _d3Prev2 ), _d3Prev, _d3Prev - _d3Prev2 ) VAR _mgPrev = DIVIDE ( _lnttMPrev, _bMPrev + _d3MPrev ) VAR _m = DIVIDE ( _mgCur - _mgPrev, ABS ( _mgPrev ) ) RETURN IF ( ISBLANK ( _m ) || ISBLANK ( _lnttPrev ), "Kỳ đầu năm (Chưa có so sánh)", IF ( _m >= 0, UNICHAR ( 9650 ) & " Tăng +" & FORMAT ( _m, "0.0%" ) & " so với Tháng " & _thangTruoc, UNICHAR ( 9660 ) & " Giảm " & FORMAT ( ABS ( _m ), "0.0%" ) & " so với Tháng " & _thangTruoc ) )
KPI Margin Color = VAR _cur = SELECTEDVALUE ( 'banking_project dim_month'[month_key], MAX ( 'banking_project dim_month'[month_key] ) ) VAR _prev = IF ( MOD ( _cur, 100 ) = 1, _cur - 100 + 11, _cur - 1 ) VAR _prev2 = IF ( MOD ( _prev, 100 ) = 1, _prev - 100 + 11, _prev - 1 ) VAR _lnttCur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _lnttPrev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _lnttM = IF ( ISBLANK ( _lnttPrev ), _lnttCur, _lnttCur - _lnttPrev ) VAR _bCur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[thu_nhap_the_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _bPrev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[thu_nhap_the_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _bM = IF ( ISBLANK ( _bPrev ), _bCur, _bCur - _bPrev ) VAR _d3Cur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[dt_kd_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _d3Prev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[dt_kd_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _d3M = IF ( ISBLANK ( _d3Prev ), _d3Cur, _d3Cur - _d3Prev ) VAR _mgCur = DIVIDE ( _lnttM, _bM + _d3M ) VAR _lnttPrev2 = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _lnttMPrev = IF ( ISBLANK ( _lnttPrev2 ), _lnttPrev, _lnttPrev - _lnttPrev2 ) VAR _bPrev2 = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[thu_nhap_the_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _bMPrev = IF ( ISBLANK ( _bPrev2 ), _bPrev, _bPrev - _bPrev2 ) VAR _d3Prev2 = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[dt_kd_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _d3MPrev = IF ( ISBLANK ( _d3Prev2 ), _d3Prev, _d3Prev - _d3Prev2 ) VAR _mgPrev = DIVIDE ( _lnttMPrev, _bMPrev + _d3MPrev ) VAR _m = DIVIDE ( _mgCur - _mgPrev, ABS ( _mgPrev ) ) RETURN SWITCH ( TRUE (), ISBLANK ( _m ) || ISBLANK ( _lnttPrev ), "#6B7280", _m >= 0, "#16A34A", "#DC2626" )

-- 6. NSBQ = LNTT thang / headcount (thang lo -> do) --
KPI NSBQ MoM Text = VAR _cur = SELECTEDVALUE ( 'banking_project dim_month'[month_key], MAX ( 'banking_project dim_month'[month_key] ) ) VAR _prev = IF ( MOD ( _cur, 100 ) = 1, _cur - 100 + 11, _cur - 1 ) VAR _prev2 = IF ( MOD ( _prev, 100 ) = 1, _prev - 100 + 11, _prev - 1 ) VAR _thangTruoc = MOD ( _prev, 100 ) VAR _lnttCur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _lnttPrev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _lnttM = IF ( ISBLANK ( _lnttPrev ), _lnttCur, _lnttCur - _lnttPrev ) VAR _smCur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[sm_count] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _nsbqCur = DIVIDE ( _lnttM, _smCur ) VAR _lnttPrev2 = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _lnttMPrev = IF ( ISBLANK ( _lnttPrev2 ), _lnttPrev, _lnttPrev - _lnttPrev2 ) VAR _smPrev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[sm_count] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _nsbqPrev = DIVIDE ( _lnttMPrev, _smPrev ) VAR _m = DIVIDE ( _nsbqCur - _nsbqPrev, ABS ( _nsbqPrev ) ) RETURN IF ( ISBLANK ( _m ) || ISBLANK ( _lnttPrev ), "Kỳ đầu năm (Chưa có so sánh)", IF ( _lnttM < 0, "n/a", IF ( _m >= 0, UNICHAR ( 9650 ) & " Tăng +" & FORMAT ( _m, "0.0%" ) & " so với Tháng " & _thangTruoc, UNICHAR ( 9660 ) & " Giảm " & FORMAT ( ABS ( _m ), "0.0%" ) & " so với Tháng " & _thangTruoc ) ) )
KPI NSBQ Color = VAR _cur = SELECTEDVALUE ( 'banking_project dim_month'[month_key], MAX ( 'banking_project dim_month'[month_key] ) ) VAR _prev = IF ( MOD ( _cur, 100 ) = 1, _cur - 100 + 11, _cur - 1 ) VAR _prev2 = IF ( MOD ( _prev, 100 ) = 1, _prev - 100 + 11, _prev - 1 ) VAR _lnttCur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _lnttPrev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _lnttM = IF ( ISBLANK ( _lnttPrev ), _lnttCur, _lnttCur - _lnttPrev ) VAR _smCur = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[sm_count] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _cur ) VAR _nsbqCur = DIVIDE ( _lnttM, _smCur ) VAR _lnttPrev2 = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[lntt_trieu_dong] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev2 ) VAR _lnttMPrev = IF ( ISBLANK ( _lnttPrev2 ), _lnttPrev, _lnttPrev - _lnttPrev2 ) VAR _smPrev = CALCULATE ( SUM ( 'banking_project v_baocao_tonghop'[sm_count] ), REMOVEFILTERS ( 'banking_project dim_month' ), 'banking_project v_baocao_tonghop'[month_key] = _prev ) VAR _nsbqPrev = DIVIDE ( _lnttMPrev, _smPrev ) VAR _m = DIVIDE ( _nsbqCur - _nsbqPrev, ABS ( _nsbqPrev ) ) RETURN SWITCH ( TRUE (), ISBLANK ( _m ) || ISBLANK ( _lnttPrev ), "#6B7280", _lnttM < 0, "#DC2626", _m >= 0, "#16A34A", "#DC2626" )
