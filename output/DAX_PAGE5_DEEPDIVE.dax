-- =====================================================================
-- DAX MEASURES DÀNH CHO TRANG 5: PHÂN TÍCH XOÁY SÂU & HÀNH ĐỘNG
-- Phục vụ bóc tách nguyên nhân lỗ & Tự động chẩn đoán điểm nghẽn ASM
-- =====================================================================

-- 1. CHẨN ĐOÁN ĐIỂM NGHẼN CHÍNH CỦA TỪNG ASM (Dynamic DAX Bottleneck)
-- Logic: So sánh 4 thứ hạng trong nhóm QM, chỉ số nào rank lớn nhất (tệ nhất) thì gắn nhãn cảnh báo
ASM_Bottleneck_Label = 
VAR _rLTN = SELECTEDVALUE('banking_project v_xephang_asm'[rank_ltn_avg], 0)
VAR _rPSDN = SELECTEDVALUE('banking_project v_xephang_asm'[rank_psdn_avg], 0)
VAR _rApp = SELECTEDVALUE('banking_project v_xephang_asm'[rank_approval_rate_avg], 0)
VAR _rNPL = SELECTEDVALUE('banking_project v_xephang_asm'[rank_npl], 0)
VAR _maxRank = MAX(MAX(_rLTN, _rPSDN), MAX(_rApp, _rNPL))
RETURN
    SWITCH(
        TRUE(),
        _maxRank = 0, BLANK(),
        _maxRank = _rNPL, "🚨 Nợ xấu NPL cao",
        _maxRank = _rApp, "⚠️ Tỉ lệ duyệt hồ sơ thấp",
        _maxRank = _rPSDN, "📉 Doanh số phát sinh yếu",
        "📉 Dư nợ bình quân thấp"
    )

-- 2. PHÂN TẦNG NĂNG LỰC THI ĐUA (Dynamic DAX Tiering)
ASM_Tier_Label = 
VAR _rank = SELECTEDVALUE('banking_project v_xephang_asm'[rank_final], 0)
RETURN
    SWITCH(
        TRUE(),
        _rank = 0, BLANK(),
        _rank <= 10, "Tier 1 - Xuất sắc (Top 10)",
        _rank <= 30, "Tier 2 - Khá (Top 30)",
        _rank <= 60, "Tier 3 - Trung bình",
        "Tier 4 - Cần cải thiện (Bét bảng)"
    )

-- 3. MÀU SẮC ĐIỂM NGHẼN (Dùng cho Conditional Formatting nền / chữ)
ASM_Bottleneck_Color = 
VAR _rLTN = SELECTEDVALUE('banking_project v_xephang_asm'[rank_ltn_avg], 0)
VAR _rPSDN = SELECTEDVALUE('banking_project v_xephang_asm'[rank_psdn_avg], 0)
VAR _rApp = SELECTEDVALUE('banking_project v_xephang_asm'[rank_approval_rate_avg], 0)
VAR _rNPL = SELECTEDVALUE('banking_project v_xephang_asm'[rank_npl], 0)
VAR _maxRank = MAX(MAX(_rLTN, _rPSDN), MAX(_rApp, _rNPL))
RETURN
    SWITCH(
        TRUE(),
        _maxRank = 0, "#6B7280",
        _maxRank = _rNPL, "#DC2626", -- Đỏ (Nợ xấu)
        _maxRank = _rApp, "#D97706", -- Cam (Duyệt trượt)
        _maxRank = _rPSDN, "#2563EB", -- Xanh dương (Doanh số)
        "#4B5563"
    )

-- 4. BÓC TÁCH CHI PHÍ ĐÔNG NAM BỘ (Dùng cho Text Callout hoặc Card)
DNB_Loss_Decomposition_Text = 
"Vùng Đông Nam Bộ Tháng 5 lỗ -48,8 tỷ đồng. Nguyên nhân: Thu nhập hoạt động đạt +218,4 tỷ (Top 2), nhưng Chi phí dự phòng nợ xấu tại chỗ lên tới -221,4 tỷ (chiếm 99,0% tổng dự phòng), nuốt sạch 102% doanh thu làm ra."
